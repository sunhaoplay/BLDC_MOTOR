   1:App/htmi_app.c **** /**
   2:App/htmi_app.c ****  * @file hmi_app.c
   3:App/htmi_app.c ****  * @brief 实现 USART1/VOFA 协议、本地按键与电位器的人机交互逻辑。
   4:App/htmi_app.c ****  *
   5:App/htmi_app.c ****  * 接收方向采用 HAL 单字节中断，把以 0xFA 结束的命令帧交给后台任务解析�
   6:App/htmi_app.c ****  * 发送方向采用 JustFloat 协议，即连续发送若干个小端 float，末尾追加固定�
   7:App/htmi_app.c ****  * 本模块还把按键事件映射为电机控制模式，并根据模式解释电位器的物理
   8:App/htmi_app.c ****  */
   9:App/htmi_app.c **** 
  10:App/htmi_app.c **** #include "htmi_app.h"
  11:App/htmi_app.c **** #include "led_drv.h"
  12:App/htmi_app.c **** #include "string.h"
  13:App/htmi_app.c **** #include "motor_ctrl.h"
  14:App/htmi_app.c **** 
  15:App/htmi_app.c **** /**
  16:App/htmi_app.c ****  * @brief 按控制模式把电位器采样值映射为对应给定量。
  17:App/htmi_app.c ****  *
  18:App/htmi_app.c ****  * 速度模式写 Para.SpeedRef，电流/IF 模式写 Para.CurRef，位置模式写
  19:App/htmi_app.c ****  * Para.PosRef；Limit_Sat() 对给定范围限幅，防止电位器端点产生越界指令。
  20:App/htmi_app.c ****  */
