  22:Sdrive/key_drv.c **** };
  23:Sdrive/key_drv.c **** 
  24:Sdrive/key_drv.c **** #define KEY_NUM_MAX (sizeof(g_gpioList) / sizeof(g_gpioList[0]))
  25:Sdrive/key_drv.c **** 
  26:Sdrive/key_drv.c **** typedef enum
  27:Sdrive/key_drv.c **** {
