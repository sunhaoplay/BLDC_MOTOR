  29:Sdrive/key_drv.c **** 	KEY_CONFIRM,     /**< 检测到低电平，等待消抖时间确认。 */
  30:Sdrive/key_drv.c **** 	KEY_SHORTPRESS,  /**< 已确认按下，等待释放或长按超时。 */
