 193:MotorFoc/param_ident.c **** /**
 194:MotorFoc/param_ident.c ****  * @brief 在指定轴施加双极性电压并累计电感拟合样本。
 195:MotorFoc/param_ident.c ****  * @param axis 被激励轴：PARAM_IDENT_AXIS_D 或 PARAM_IDENT_AXIS_Q。
 196:MotorFoc/param_ident.c ****  * @param center_voltage 激励的中心电压（归一化）。
 197:MotorFoc/param_ident.c ****  * @param excite_voltage 双极性激励幅值（归一化）。
 198:MotorFoc/param_ident.c ****  * @param target_sample_count 目标有效样本数。
 199:MotorFoc/param_ident.c ****  * @return true 表示有效样本已集满；false 表示仍在激励采样。
 200:MotorFoc/param_ident.c ****  */
 201:MotorFoc/param_ident.c **** static bool ParamIdent_RunAxisExcitation(uint8_t axis,
 202:MotorFoc/param_ident.c ****     float center_voltage,
 203:MotorFoc/param_ident.c ****     float excite_voltage,
 204:MotorFoc/param_ident.c ****     uint16_t target_sample_count)
 205:MotorFoc/param_ident.c **** {
 206:MotorFoc/param_ident.c ****     float axis_current;
 207:MotorFoc/param_ident.c ****     float current_slope;
 208:MotorFoc/param_ident.c ****     float current_mid;
 209:MotorFoc/param_ident.c ****     float model_voltage;
 210:MotorFoc/param_ident.c ****     float axis_voltage;
 211:MotorFoc/param_ident.c **** 
 212:MotorFoc/param_ident.c ****     axis_current = (axis == PARAM_IDENT_AXIS_D) ? Park.Ds : Park.Qs;
 213:MotorFoc/param_ident.c **** 
 214:MotorFoc/param_ident.c ****     // CCR预装载使电压指令延迟生效，使用两级队列把ΔI与实际生效电压配�
 215:MotorFoc/param_ident.c ****     if (g_paramIdentRuntime.axis_prev_valid &&
 216:MotorFoc/param_ident.c ****         (g_paramIdentRuntime.axis_voltage_delay_count >= 2U))
 217:MotorFoc/param_ident.c ****     {
 218:MotorFoc/param_ident.c ****         // x为电流变化率，y为扣除Rs压降后的电感电压
ARM GAS  C:\Users\sunhao\AppData\Local\Temp\ccsSkEmG.s 			page 10


 219:MotorFoc/param_ident.c ****         current_slope = (axis_current - g_paramIdentRuntime.axis_last_current) / TS;
 220:MotorFoc/param_ident.c ****         current_mid = 0.5f * (axis_current + g_paramIdentRuntime.axis_last_current);
 221:MotorFoc/param_ident.c ****         model_voltage = g_paramIdentRuntime.axis_voltage_delay_1 -
 222:MotorFoc/param_ident.c ****             g_paramIdent.result_Rs * current_mid;
 223:MotorFoc/param_ident.c **** 
 224:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_sum_x += current_slope;
 225:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_sum_y += model_voltage;
 226:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_sum_xx += current_slope * current_slope;
 227:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_sum_xy += current_slope * model_voltage;
 228:MotorFoc/param_ident.c ****         g_paramIdent.sample_count++;
 229:MotorFoc/param_ident.c ****     }
 230:MotorFoc/param_ident.c **** 
 231:MotorFoc/param_ident.c ****     // 达到目标有效样本数后停止继续切换激励极性
 232:MotorFoc/param_ident.c ****     if (g_paramIdent.sample_count >= target_sample_count)
 233:MotorFoc/param_ident.c ****     {
 234:MotorFoc/param_ident.c ****         return true;
 235:MotorFoc/param_ident.c ****     }
 236:MotorFoc/param_ident.c **** 
 237:MotorFoc/param_ident.c ****     // 每个20kHz控制周期翻转一次激励极性
 238:MotorFoc/param_ident.c ****     axis_voltage = center_voltage;
 239:MotorFoc/param_ident.c ****     if (g_paramIdentRuntime.axis_polarity == 0U)
 240:MotorFoc/param_ident.c ****     {
 241:MotorFoc/param_ident.c ****         axis_voltage += excite_voltage;
 242:MotorFoc/param_ident.c ****         // 根据被辨识轴的电流极性叠加死区补偿电压
 243:MotorFoc/param_ident.c ****         if (axis_current > 0.01f)       // 正电流，电压往上补
 244:MotorFoc/param_ident.c ****         {
 245:MotorFoc/param_ident.c ****          axis_voltage += DEAD_ZONE_COMP;
 246:MotorFoc/param_ident.c ****         }
 247:MotorFoc/param_ident.c ****     else if (axis_current < -0.01f)  // 负电流，电压往下补
 248:MotorFoc/param_ident.c ****         {
 249:MotorFoc/param_ident.c ****         axis_voltage -= DEAD_ZONE_COMP;
 250:MotorFoc/param_ident.c ****         }
 251:MotorFoc/param_ident.c ****         // ±0.01A死区不补偿，避免过零附近振荡
 252:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_polarity = 1U;
 253:MotorFoc/param_ident.c ****     }
 254:MotorFoc/param_ident.c ****     else
 255:MotorFoc/param_ident.c ****     {
 256:MotorFoc/param_ident.c ****         if (axis_current > 0.01f)       // 正电流，电压往上补
 257:MotorFoc/param_ident.c ****         {
 258:MotorFoc/param_ident.c ****          axis_voltage += DEAD_ZONE_COMP;
 259:MotorFoc/param_ident.c ****         }
 260:MotorFoc/param_ident.c ****     else if (axis_current < -0.01f)  // 负电流，电压往下补
 261:MotorFoc/param_ident.c ****         {
 262:MotorFoc/param_ident.c ****         axis_voltage -= DEAD_ZONE_COMP;
 263:MotorFoc/param_ident.c ****         }
 264:MotorFoc/param_ident.c ****         // ±0.01A死区不补偿，避免过零附近振荡
 265:MotorFoc/param_ident.c ****         axis_voltage -= excite_voltage;
 266:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_polarity = 0U;
 267:MotorFoc/param_ident.c ****     }
 268:MotorFoc/param_ident.c **** 
 269:MotorFoc/param_ident.c ****     // 被辨识轴直接注入电压，正交轴继续维持零电流闭环
 270:MotorFoc/param_ident.c ****     if (axis == PARAM_IDENT_AXIS_D)
 271:MotorFoc/param_ident.c ****     {
 272:MotorFoc/param_ident.c ****         ParamIdent_ApplyVoltage(axis_voltage, 0.0f, PARAM_IDENT_CONTROL_Q_AXIS);
 273:MotorFoc/param_ident.c ****     }
 274:MotorFoc/param_ident.c ****     else
 275:MotorFoc/param_ident.c ****     {
ARM GAS  C:\Users\sunhao\AppData\Local\Temp\ccsSkEmG.s 			page 11


 276:MotorFoc/param_ident.c ****         ParamIdent_ApplyVoltage(0.0f, axis_voltage, PARAM_IDENT_CONTROL_D_AXIS);
 277:MotorFoc/param_ident.c ****     }
 278:MotorFoc/param_ident.c **** 
 279:MotorFoc/param_ident.c ****     // 保存本周期数据，下一周期用于电压与电流变化延迟配对
 280:MotorFoc/param_ident.c ****     g_paramIdentRuntime.axis_last_current = axis_current;
 281:MotorFoc/param_ident.c ****     if (g_paramIdentRuntime.axis_voltage_delay_count == 0U)
 282:MotorFoc/param_ident.c ****     {
 283:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_1 = ParamIdent_ActualVoltage(axis_voltage);
 284:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_count = 1U;
 285:MotorFoc/param_ident.c ****     }
 286:MotorFoc/param_ident.c ****     else
 287:MotorFoc/param_ident.c ****     {
 288:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_2 = g_paramIdentRuntime.axis_voltage_delay_1;
 289:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_1 = ParamIdent_ActualVoltage(axis_voltage);
 290:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_count = 2U;
 291:MotorFoc/param_ident.c ****     }
 292:MotorFoc/param_ident.c ****     g_paramIdentRuntime.axis_prev_valid = true;
 293:MotorFoc/param_ident.c **** 
 294:MotorFoc/param_ident.c ****     return false;
 295:MotorFoc/param_ident.c **** }
