 192:MotorFoc/param_ident.c **** /**
 193:MotorFoc/param_ident.c ****  * @brief 在指定轴施加双极性电压并累计电感拟合样本。
 194:MotorFoc/param_ident.c ****  * @param axis 被激励轴：PARAM_IDENT_AXIS_D 或 PARAM_IDENT_AXIS_Q。
 195:MotorFoc/param_ident.c ****  * @param center_voltage 激励的中心电压（归一化）。
 196:MotorFoc/param_ident.c ****  * @param excite_voltage 双极性激励幅值（归一化）。
 197:MotorFoc/param_ident.c ****  * @param target_sample_count 目标有效样本数。
 198:MotorFoc/param_ident.c ****  * @return true 表示有效样本已集满；false 表示仍在激励采样。
 199:MotorFoc/param_ident.c ****  */
 200:MotorFoc/param_ident.c **** static bool ParamIdent_RunAxisExcitation(uint8_t axis,
 201:MotorFoc/param_ident.c ****     float center_voltage,
 202:MotorFoc/param_ident.c ****     float excite_voltage,
 203:MotorFoc/param_ident.c ****     uint16_t target_sample_count)
 204:MotorFoc/param_ident.c **** {
 205:MotorFoc/param_ident.c ****     float axis_current;
 206:MotorFoc/param_ident.c ****     float current_slope;
 207:MotorFoc/param_ident.c ****     float current_mid;
 208:MotorFoc/param_ident.c ****     float model_voltage;
 209:MotorFoc/param_ident.c ****     float axis_voltage;
 210:MotorFoc/param_ident.c **** 
 211:MotorFoc/param_ident.c ****     axis_current = (axis == PARAM_IDENT_AXIS_D) ? Park.Ds : Park.Qs;
 212:MotorFoc/param_ident.c **** 
 213:MotorFoc/param_ident.c ****     // CCR预装载使电压指令延迟生效，使用两级队列把ΔI与实际生效电压配�
 214:MotorFoc/param_ident.c ****     if (g_paramIdentRuntime.axis_prev_valid &&
 215:MotorFoc/param_ident.c ****         (g_paramIdentRuntime.axis_voltage_delay_count >= 2U))
 216:MotorFoc/param_ident.c ****     {
 217:MotorFoc/param_ident.c ****         // x为电流变化率，y为扣除Rs压降后的电感电压
 218:MotorFoc/param_ident.c ****         current_slope = (axis_current - g_paramIdentRuntime.axis_last_current) / TS;
ARM GAS  C:\Users\sunhao\AppData\Local\Temp\ccRMtwbf.s 			page 10


 219:MotorFoc/param_ident.c ****         current_mid = 0.5f * (axis_current + g_paramIdentRuntime.axis_last_current);
 220:MotorFoc/param_ident.c ****         model_voltage = g_paramIdentRuntime.axis_voltage_delay_2 -
 221:MotorFoc/param_ident.c ****             g_paramIdent.result_Rs * current_mid;
 222:MotorFoc/param_ident.c **** 
 223:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_sum_x += current_slope;
 224:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_sum_y += model_voltage;
 225:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_sum_xx += current_slope * current_slope;
 226:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_sum_xy += current_slope * model_voltage;
 227:MotorFoc/param_ident.c ****         g_paramIdent.sample_count++;
 228:MotorFoc/param_ident.c ****     }
 229:MotorFoc/param_ident.c **** 
 230:MotorFoc/param_ident.c ****     // 达到目标有效样本数后停止继续切换激励极性
 231:MotorFoc/param_ident.c ****     if (g_paramIdent.sample_count >= target_sample_count)
 232:MotorFoc/param_ident.c ****     {
 233:MotorFoc/param_ident.c ****         return true;
 234:MotorFoc/param_ident.c ****     }
 235:MotorFoc/param_ident.c **** 
 236:MotorFoc/param_ident.c ****     // 每个20kHz控制周期翻转一次激励极性
 237:MotorFoc/param_ident.c ****     axis_voltage = center_voltage;
 238:MotorFoc/param_ident.c ****     if (g_paramIdentRuntime.axis_polarity == 0U)
 239:MotorFoc/param_ident.c ****     {
 240:MotorFoc/param_ident.c ****         axis_voltage += excite_voltage;
 241:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_polarity = 1U;
 242:MotorFoc/param_ident.c ****     }
 243:MotorFoc/param_ident.c ****     else
 244:MotorFoc/param_ident.c ****     {
 245:MotorFoc/param_ident.c ****         axis_voltage -= excite_voltage;
 246:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_polarity = 0U;
 247:MotorFoc/param_ident.c ****     }
 248:MotorFoc/param_ident.c **** 
 249:MotorFoc/param_ident.c ****     // 被辨识轴直接注入电压，正交轴继续维持零电流闭环
 250:MotorFoc/param_ident.c ****     if (axis == PARAM_IDENT_AXIS_D)
 251:MotorFoc/param_ident.c ****     {
 252:MotorFoc/param_ident.c ****         ParamIdent_ApplyVoltage(axis_voltage, 0.0f, PARAM_IDENT_CONTROL_Q_AXIS);
 253:MotorFoc/param_ident.c ****     }
 254:MotorFoc/param_ident.c ****     else
 255:MotorFoc/param_ident.c ****     {
 256:MotorFoc/param_ident.c ****         ParamIdent_ApplyVoltage(0.0f, axis_voltage, PARAM_IDENT_CONTROL_D_AXIS);
 257:MotorFoc/param_ident.c ****     }
 258:MotorFoc/param_ident.c **** 
 259:MotorFoc/param_ident.c ****     // 保存本周期数据，下一周期用于电压与电流变化延迟配对
 260:MotorFoc/param_ident.c ****     g_paramIdentRuntime.axis_last_current = axis_current;
 261:MotorFoc/param_ident.c ****     if (g_paramIdentRuntime.axis_voltage_delay_count == 0U)
 262:MotorFoc/param_ident.c ****     {
 263:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_1 = ParamIdent_ActualVoltage(axis_voltage);
 264:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_count = 1U;
 265:MotorFoc/param_ident.c ****     }
 266:MotorFoc/param_ident.c ****     else
 267:MotorFoc/param_ident.c ****     {
 268:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_2 = g_paramIdentRuntime.axis_voltage_delay_1;
 269:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_1 = ParamIdent_ActualVoltage(axis_voltage);
 270:MotorFoc/param_ident.c ****         g_paramIdentRuntime.axis_voltage_delay_count = 2U;
 271:MotorFoc/param_ident.c ****     }
 272:MotorFoc/param_ident.c ****     g_paramIdentRuntime.axis_prev_valid = true;
 273:MotorFoc/param_ident.c **** 
 274:MotorFoc/param_ident.c ****     return false;
 275:MotorFoc/param_ident.c **** }
