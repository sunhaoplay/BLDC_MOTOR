   1:Sdrive/adc_drv.c **** /**
   2:Sdrive/adc_drv.c ****  * @file adc_drv.c
   3:Sdrive/adc_drv.c ****  * @brief 实现 ADC 零点校准、物理量换算和一阶低通滤波。
   4:Sdrive/adc_drv.c ****  *
   5:Sdrive/adc_drv.c ****  * DMA 通道顺序由 CubeMX 配置决定：代码使用索引 0/3 采 U/W 相电流，索引 2
   6:Sdrive/adc_drv.c ****  * 采母线电压，索引 1 采温度，索引 4 采电位器。GetAdc() 在 TIM1 20 kHz
   7:Sdrive/adc_drv.c ****  * 更新中断中调用，因此换算和滤波必须保持短小、确定且不可阻塞。
   8:Sdrive/adc_drv.c ****  */
   9:Sdrive/adc_drv.c **** 
  10:Sdrive/adc_drv.c **** #include "task.h"
  11:Sdrive/adc_drv.c **** #include "motor_para.h"
  12:Sdrive/adc_drv.c **** ADC_Sample AdcPara = ADC_Sample_DEFAULTS;       /**< 当前一拍未经低通的采样物理量。 
  13:Sdrive/adc_drv.c **** ADC_Sample_F AdcFilPara = ADC_Sample_F_DEFAULTS; /**< 当前一拍低通后的采样物理量。 */
  14:Sdrive/adc_drv.c **** 
  15:Sdrive/adc_drv.c **** uint16_t ADC_Value[5];
  16:Sdrive/adc_drv.c **** 
  17:Sdrive/adc_drv.c **** /**
  18:Sdrive/adc_drv.c ****  * @brief 在零电流条件下估计 U、W 两相电流采样的 ADC 偏置。
  19:Sdrive/adc_drv.c ****  *
  20:Sdrive/adc_drv.c ****  * 外层执行 10 次，每次等待并读取约 100 ms 后把该次末值累加，最终取 10 �
  21:Sdrive/adc_drv.c ****  * 后续相电流换算使用 I=(Offset-ADC)*I_GAIN 消除运放和 ADC 的静态零漂。
  22:Sdrive/adc_drv.c ****  * @warning 校准期间功率级必须没有相电流，否则该电流会被误认为零点并带
  23:Sdrive/adc_drv.c ****  */
  24:Sdrive/adc_drv.c **** void AdcSampleOffset(void)
  25:Sdrive/adc_drv.c **** {
  26:Sdrive/adc_drv.c **** 	uint8_t i = 0;
  27:Sdrive/adc_drv.c **** 	uint8_t j = 0;
  28:Sdrive/adc_drv.c **** 	uint16_t Sum1 = 0;
  29:Sdrive/adc_drv.c **** 	uint16_t Sum2 = 0;
  30:Sdrive/adc_drv.c **** 
  31:Sdrive/adc_drv.c **** 	for (i = 0; i < 10; i++)
ARM GAS  C:\Users\sunhao\AppData\Local\Temp\ccns1riE.s 			page 2


  32:Sdrive/adc_drv.c **** 	{
  33:Sdrive/adc_drv.c **** 		for (j = 0; j < 100; j++)
  34:Sdrive/adc_drv.c **** 		{
  35:Sdrive/adc_drv.c **** 			AdcPara.OffsetCurU = ADC_Value[0];
  36:Sdrive/adc_drv.c **** 			AdcPara.OffsetCurW = ADC_Value[3];
  37:Sdrive/adc_drv.c **** 
  38:Sdrive/adc_drv.c **** 			HAL_Delay(1);
  39:Sdrive/adc_drv.c **** 		}
  40:Sdrive/adc_drv.c **** 		Sum1 += AdcPara.OffsetCurU;
  41:Sdrive/adc_drv.c **** 		Sum2 += AdcPara.OffsetCurW;
  42:Sdrive/adc_drv.c **** 	}
  43:Sdrive/adc_drv.c **** 	AdcFilPara.OffsetCurU = Sum1 / 10;
  44:Sdrive/adc_drv.c **** 	AdcFilPara.OffsetCurW = Sum2 / 10;
  45:Sdrive/adc_drv.c **** }
  46:Sdrive/adc_drv.c **** 
  47:Sdrive/adc_drv.c **** /**
  48:Sdrive/adc_drv.c ****  * @brief 将 ADC DMA 原始码值换算为三相电流、母线电压和辅助通道值。
  49:Sdrive/adc_drv.c ****  *
  50:Sdrive/adc_drv.c ****  * U/W 相：I=(Offset-ADC)*I_GAIN；V 相由星形电机无中性线条件
  51:Sdrive/adc_drv.c ****  * Iu+Iv+Iw=0 重构，即 Iv=-Iu-Iw。母线电压使用 Vbus=ADC*VBUS_GAIN。
  52:Sdrive/adc_drv.c ****  */
  53:Sdrive/adc_drv.c **** static void AdcSample(void)
