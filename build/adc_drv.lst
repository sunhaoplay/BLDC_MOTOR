 111:Sdrive/adc_drv.c ****             __DMB();//保证前面写偏移/清电流对等待线程可见
 112:Sdrive/adc_drv.c ****             offset_ready = 1U;
 113:Sdrive/adc_drv.c ****         }
 114:Sdrive/adc_drv.c ****     }
 115:Sdrive/adc_drv.c **** 
 116:Sdrive/adc_drv.c ****     if (offset_ready == 0U)
 117:Sdrive/adc_drv.c ****         return;
 118:Sdrive/adc_drv.c ****     /* 保留原有电流符号定义，传感器增益及极性仍须通过实测确认。 */
 119:Sdrive/adc_drv.c ****     AdcPara.CurU = (float)((int32_t)AdcFilPara.OffsetCurU - raw_u) * I_GAIN;
