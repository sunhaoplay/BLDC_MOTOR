 108:Sdrive/adc_drv.c ****             AdcPara.OffsetCurW = AdcFilPara.OffsetCurW = w;
 109:Sdrive/adc_drv.c ****             AdcFilPara.CurU = AdcFilPara.CurV = AdcFilPara.CurW = 0.0f;
