  98:Sdrive/adc_drv.c **** 
  99:Sdrive/adc_drv.c ****     if (offset_active != 0U)
 100:Sdrive/adc_drv.c ****     {
 101:Sdrive/adc_drv.c ****         offset_sum_u += raw_u;
 102:Sdrive/adc_drv.c ****         offset_sum_w += raw_w;
 103:Sdrive/adc_drv.c ****         if (++offset_count == ADC_OFFSET_SAMPLES)
 104:Sdrive/adc_drv.c ****         {
