  93:App/task.c    **** /* 无需在线调试的上传诊断：每 500 ms 判断进展，每 4 s 用红灯闪次数报状�
  94:App/task.c    ****  * 仅在主循环操作 LED，不向串口插入诊断文本，也不等待发送。
  95:App/task.c    ****  */
  96:App/task.c    **** static void WaveLedService(uint32_t now)
  97:App/task.c    **** {
  98:App/task.c    ****     static uint32_t last_check, last_sent, last_errors, last_dropped;
  99:App/task.c    ****     static uint32_t pattern_start;
 100:App/task.c    ****     static uint8_t code = 3U;
 101:App/task.c    **** 
 102:App/task.c    ****     if ((uint32_t)(now - last_check) >= 500U)
 103:App/task.c    ****     {
 104:App/task.c    ****         last_check = now;
 105:App/task.c    ****         const uint32_t sent = FocWaveSent;
 106:App/task.c    ****         const uint32_t errors = FocWaveTxErrors;
 107:App/task.c    ****         const uint32_t dropped = FocWaveDropped;
 108:App/task.c    ****         uint8_t next;
 109:App/task.c    ****         if (FocWaveFault == 1U)
 110:App/task.c    ****             next = 1U; /* 上传速率超过配置的串口带宽。 */
 111:App/task.c    ****         else if (FocWaveFault != 0U)
 112:App/task.c    ****             next = 2U; /* 未取得串口发送权。 */
 113:App/task.c    ****         else if (FocWaveEnabled == 0U || !Init_Over || FocWaveSamples == 0U)
 114:App/task.c    ****             next = 3U; /* 未开始采集或已停止。 */
 115:App/task.c    ****         else if (errors != last_errors)
 116:App/task.c    ****             next = 5U; /* DMA 启动/传输错误。 */
 117:App/task.c    ****         else if (sent == last_sent)
 118:App/task.c    ****             next = 4U; /* 已有数据，但本窗口没有确认发送完成。 */
 119:App/task.c    ****         else if (dropped != last_dropped)
 120:App/task.c    ****             next = 6U; /* 发送在进行，但队列发生拥堵丢点。 */
 121:App/task.c    ****         else
 122:App/task.c    ****             next = 0U; /* 已确认有新的串口发送完成。 */
 123:App/task.c    **** 
 124:App/task.c    ****         last_sent = sent;
 125:App/task.c    ****         last_errors = errors;
 126:App/task.c    ****         last_dropped = dropped;
 127:App/task.c    ****         if (next != code)
 128:App/task.c    ****         {
 129:App/task.c    ****             code = next;
 130:App/task.c    ****             pattern_start = now;
 131:App/task.c    ****         }
 132:App/task.c    ****     }
ARM GAS  C:\Users\sunhao\AppData\Local\Temp\ccNjcXhs.s 			page 7


 133:App/task.c    **** 
 134:App/task.c    ****     if (code == 0U)
 135:App/task.c    ****         TurnOnLed(LED_G);
 136:App/task.c    ****     else
 137:App/task.c    ****         TurnOffLed(LED_G);
 138:App/task.c    **** 
 139:App/task.c    ****     const uint32_t phase = (uint32_t)(now - pattern_start) % 4000U;
 140:App/task.c    ****     if (code != 0U && phase < (uint32_t)code * 400U && phase % 400U < 200U)
 141:App/task.c    ****         TurnOnLed(LED_R);
 142:App/task.c    ****     else
 143:App/task.c    ****         TurnOffLed(LED_R);
 144:App/task.c    **** }
