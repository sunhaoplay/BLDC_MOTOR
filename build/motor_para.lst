 274:MotorFoc/motor_para.c **** // 实现ln(x) 的计算
 275:MotorFoc/motor_para.c **** /*
 276:MotorFoc/motor_para.c **** double myln(double a)
 277:MotorFoc/motor_para.c **** {
 278:MotorFoc/motor_para.c ****    int N = 15;//取了前15+1项来估算
 279:MotorFoc/motor_para.c ****    int k,nk;
 280:MotorFoc/motor_para.c ****    double x,xx,y;
 281:MotorFoc/motor_para.c ****    x = (a-1)/(a+1);
 282:MotorFoc/motor_para.c ****    xx = x*x;
 283:MotorFoc/motor_para.c ****    nk = 2*N+1;
 284:MotorFoc/motor_para.c ****    y = 1.0/nk;
 285:MotorFoc/motor_para.c ****    for(k=N;k>0;k--)
 286:MotorFoc/motor_para.c ****    {
 287:MotorFoc/motor_para.c **** 	 nk = nk - 2;
 288:MotorFoc/motor_para.c **** 	 y = 1.0/nk+xx*y;
 289:MotorFoc/motor_para.c **** 
 290:MotorFoc/motor_para.c ****    }
 291:MotorFoc/motor_para.c ****    return 2.0*x*y;
 292:MotorFoc/motor_para.c **** }
 293:MotorFoc/motor_para.c **** */
 294:MotorFoc/motor_para.c **** 
