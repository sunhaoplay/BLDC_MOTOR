  57:MotorFoc/motor_ctrl.c **** /**
  58:MotorFoc/motor_ctrl.c ****  * @brief 禁止电流闭环和三相功率输出，保留 TIM1 计数及 CH4 内部采样触发。
  59:MotorFoc/motor_ctrl.c ****  */
  60:MotorFoc/motor_ctrl.c **** void MotorStop(void)
  61:MotorFoc/motor_ctrl.c **** {
  62:MotorFoc/motor_ctrl.c **** 	// Init_Over = false;
  63:MotorFoc/motor_ctrl.c **** 	TIM1->CCER &= ~MOTOR_PWM_CHANNEL_MASK;
  64:MotorFoc/motor_ctrl.c **** 	TIM1->CCR1 = TIM1_PERIOD_HALF;
  65:MotorFoc/motor_ctrl.c **** 	TIM1->CCR2 = TIM1_PERIOD_HALF;
  66:MotorFoc/motor_ctrl.c **** 	TIM1->CCR3 = TIM1_PERIOD_HALF;
  67:MotorFoc/motor_ctrl.c **** 	VariableClear();
  68:MotorFoc/motor_ctrl.c **** }
  69:MotorFoc/motor_ctrl.c **** 
