   1:MotorFoc/sen.c **** /**
   2:MotorFoc/sen.c ****  * @file sen.c
   3:MotorFoc/sen.c ****  * @brief 实现编码器有感 FOC 的调零、电流环、速度环和位置环。
   4:MotorFoc/sen.c ****  *
   5:MotorFoc/sen.c ****  * 闭环级联关系为：位置误差 -> 速度给定 -> q 轴电流给定 -> q 轴电压；d 轴
   6:MotorFoc/sen.c ****  * 电流固定为零。电流环使用 20 kHz 控制角度，速度和位置环通过软件分频�
   7:MotorFoc/sen.c ****  */
   8:MotorFoc/sen.c **** 
   9:MotorFoc/sen.c **** #include "motor_ctrl.h"
  10:MotorFoc/sen.c **** #include "sen.h"
  11:MotorFoc/sen.c **** #include "motor_para.h"
  12:MotorFoc/sen.c **** /**
  13:MotorFoc/sen.c ****  * @brief 用固定 alpha 轴电压吸合转子并把当前位置定义为编码器零点。
  14:MotorFoc/sen.c ****  *
  15:MotorFoc/sen.c ****  * 先使能六路互补 PWM，输出 Ualpha=1、Ubeta=0 的静止电压矢量并等待转子稳定
  16:MotorFoc/sen.c ****  * 然后清零 TIM3->CNT 和 Motor.E_theta，最后关闭 PWM 输出。
  17:MotorFoc/sen.c ****  * @warning 函数包含秒级阻塞延时并会产生保持转矩，只能在停机校准流程调
  18:MotorFoc/sen.c ****  */
