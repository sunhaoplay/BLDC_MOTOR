 165:MotorFoc/sen.c **** #define ENC_MIN 1
 166:MotorFoc/sen.c **** #define ENC_MAX 3999
 167:MotorFoc/sen.c **** #define ENC_RANGE (ENC_MAX - ENC_MIN + 1)
 168:MotorFoc/sen.c **** #define POS_MAX_SPEED 3000
