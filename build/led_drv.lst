  14:Sdrive/led_drv.c **** 	uint32_t pin;       /**< LED 通道对应的 GPIO 位掩码。 */
  15:Sdrive/led_drv.c **** } Led_GPIO_t;
  16:Sdrive/led_drv.c **** 
  17:Sdrive/led_drv.c **** static Led_GPIO_t g_gpioList[] =
  18:Sdrive/led_drv.c **** {
  19:Sdrive/led_drv.c **** 	{LED_B_GPIO_Port, LED_B_Pin},
  20:Sdrive/led_drv.c ****     {LED_G_GPIO_Port, LED_G_Pin},
  21:Sdrive/led_drv.c ****     {LED_R_GPIO_Port, LED_R_Pin}
  22:Sdrive/led_drv.c **** };
  23:Sdrive/led_drv.c **** 
  24:Sdrive/led_drv.c **** #define LED_NUM_MAX (sizeof(g_gpioList) / sizeof(g_gpioList[0]))
  25:Sdrive/led_drv.c **** 
  26:Sdrive/led_drv.c **** /**
  27:Sdrive/led_drv.c ****  * @brief 把指定 LED 引脚拉低以点亮通道。
